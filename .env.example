# Public URL of the shop (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://shopalicialux.se

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # anon / publishable key (sb_publishable_… or eyJ…)
SUPABASE_SERVICE_ROLE_KEY=            # service_role / secret key — server only, never expose
# Supabase → Connect → Session pooler URI (only needed for scripts/supabase-setup.sh)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Stripe → Developers → API keys (use test keys until you've tested a full order)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
STRIPE_SECRET_KEY=sk_test_…
# Stripe → Developers → Webhooks → endpoint https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_…

# Shown in the footer and on policy pages
NEXT_PUBLIC_SUPPORT_EMAIL=
STORE_LEGAL_NAME=
STORE_ORGANISATION_NUMBER=
STORE_BUSINESS_ADDRESS=
